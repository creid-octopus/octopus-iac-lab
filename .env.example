# Copy to .env per worktree. Holds secrets + per-target URL only — non-sensitive
# lab config (CaC repo coords, agent settings) lives in committed
# `tofu/<stack>/defaults.auto.tfvars`.

# compose/docker-compose.yml — local self-host only. Ignored when targeting SaaS.
# MASTER_KEY encrypts the Octopus database. Generate once, never change after
# first boot or you'll lose access to encrypted data.
#   openssl rand -base64 16
MASTER_KEY=CHANGE_ME

# Optional. Base64 of your Octopus licence XML — install.sh applies it on first
# boot, no UI paste needed. Encode once with:
#   base64 -i license.xml | tr -d '\n'
# Leave unset to paste via UI under Configuration → License instead.
#OCTOPUS_SERVER_BASE64_LICENSE=PExpY2Vuc2U+...

# tofu/ — exported by the Makefile as TF_VAR_octopus_url, TF_VAR_octopus_api_key,
# TF_VAR_github_pat. OCTOPUS_URL switches the worktree between local and SaaS:
#   local: http://localhost:8090
#   SaaS:  https://<your-instance-id>.octopus.app
OCTOPUS_URL=http://localhost:8090
OCTOPUS_API_KEY=API-XXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_PAT=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional. Default to host.docker.internal flavours (right for local self-host).
# For SaaS set both to the public Octopus URL — the polling tentacle inside
# Docker Desktop K8s reaches Octopus over the internet either way.
#OCTOPUS_URL_FROM_CLUSTER=https://<id>.octopus.app
#OCTOPUS_POLLING_URL_FROM_CLUSTER=https://<id>.octopus.app:10943

# Platform Hub is Enterprise-tier on SaaS. Set false to skip the resources
# entirely (count = 0). Defaults true.
#OCTOPUS_PLATFORM_HUB_ENABLED=false

# Make IaC Sandbox the default landing Space. Defaults true (self-host).
# Octopus Cloud has a managed Default Space tofu can't demote — set false there.
#OCTOPUS_SPACE_IS_DEFAULT=false

# K8s agent name + namespace are derived from OCTOPUS_URL inside the agent
# stack: octopus.app → octopus-tentacle-saas, else octopus-tentacle-local.
# The NFS CSI driver is installed via `helm upgrade --install` (idempotent
# across worktrees). Neither needs a flag here.

# Sealed-secrets controller keypair, persisted so SealedSecrets in git
# stay decryptable across cluster resets. Leave unset on first install —
# the k8s-agent stack writes the freshly-generated key here automatically.
# On subsequent installs (cluster reset, `make nuke`, etc.) the same
# stack pre-restores it before the controller comes up.
#SEALED_SECRETS_TLS_B64=

# --- local Gitea (offline git, opt-in) -----------------------------------
# Only needed when running the lab against the local Gitea instance instead
# of github.com (conference / bad-wifi mode). See docs/local-gitea.md.
#
# Defaults below match compose/gitea.yaml + configure-gitea.sh, so you can
# leave all of these unset and `make gitea-bootstrap` still works.
#GITEA_ADMIN_USER=admin
#GITEA_ADMIN_PASSWORD=Admin123!
#GITEA_REPO=octopus-iac-lab
#
# Written automatically by `make gitea-bootstrap` — don't set it by hand.
# Used by `make gitea-push` and (Phase 2) the Actions runner secrets.
#GITEA_TOKEN=

# ServiceNow integration — used by demo/servicenow-cr-gate. Octopus's
# ServiceNow ITSM connection authenticates with basic auth against a
# Personal Developer Instance (PDI). Spin one up at https://developer.servicenow.com,
# then put your instance URL in the Octopus ITSM connection (Configuration →
# ITSM) and your PDI admin credentials here. Leave unset on worktrees that
# don't need the gate.
#SERVICENOW_USERNAME=admin
#SERVICENOW_PASSWORD=CHANGE_ME
