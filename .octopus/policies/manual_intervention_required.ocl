name = "Manual intervention required"
description = "Requires manual intervention steps to be present and not skipped on deployments to Production environments."
violation_action = "block"
violation_reason = "Deployments to production require Manual Intervention steps to be enabled and not skipped."

conditions {
    rego = <<-EOT
            package manual_intervention_required
            
            # No `action` set anywhere, deliberately: the policy's Violation action field
            # stays authoritative, so warn -> block is a metadata change, not a republish.
            default result := {
            	"allowed": false,
            	"reason": "Production deployments must include an enabled manual intervention step.",
            }
            
            # A step that actually gates: manual, enabled, and not skipped for this run.
            valid_approval_step if {
            	some step in input.Steps
            	step.ActionType == "Octopus.Manual"
            	step.Enabled
            	not step.Id in input.SkippedSteps
            }
            
            # Someone explicitly skipped an approval when creating the deployment.
            approval_skipped if {
            	some step in input.Steps
            	step.ActionType == "Octopus.Manual"
            	step.Id in input.SkippedSteps
            }
            
            result := {"allowed": true} if {
            	valid_approval_step
            	not approval_skipped
            }
            
            result := {
            	"allowed": false,
            	"reason": "Manual intervention steps cannot be skipped when deploying to this environment.",
            } if {
            	approval_skipped
            }
            EOT
}

scope {
    rego = <<-EOT
            package manual_intervention_required
            
            default evaluate := false
            
            # Production deployments in this lab's space only. Dev stays unblocked so the
            # normal build → auto-deploy-to-Dev loop keeps working.
            evaluate if {
                input.Environment.Name == "Production"
                input.Space.Name == "IaC Sandbox"
            }
            EOT
}