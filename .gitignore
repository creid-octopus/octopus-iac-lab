# Secrets — stay local
.env
compose/license.xml
terraform.tfvars
secrets.auto.tfvars
*.secrets.tfvars
# Note: defaults.auto.tfvars and other non-sensitive *.auto.tfvars ARE
# committed — they hold lab-wide config like the Octopus URL.
# Exception: git-backend.auto.tfvars is generated per-machine by
# compose/set-git-backend.sh to override whichever git-backend vars aren't
# already on the right side by default.
git-backend.auto.tfvars
gitea.auto.tfvars

# OpenTofu state — has secrets, machine-specific
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Node
scripts/node_modules/
scripts/snow-debug-*.png
scripts/snow-debug-*.html
demos/node_modules/
demos/package*.json

# macOS
.DS_Store
demos/out/
.claude/
license.xml
docs/conference-demo-readiness.md
docs/local-stack-overview.md
